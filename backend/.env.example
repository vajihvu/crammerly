# ==============================
# Crammerly Backend — Environment Variables
# ==============================
# Copy this file to .env.development / .env.production and fill in values.

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database (one of these is required) ---
MONGO_URI=mongodb://localhost:27017/crammerly

# --- Authentication ---
JWT_SECRET=<min-64-char-high-entropy-random-string>
JWT_REFRESH_SECRET=<min-32-char-high-entropy-random-string>

# --- CORS / Cookies ---
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# --- Email (SMTP) — required for registration & password recovery ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<smtp-api-key>
SMTP_FROM=noreply@crammerly.io

# --- Optional Services ---
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=<oauth-client-id>.apps.googleusercontent.com
DEEPSEEK_API_KEY=<deepseek-api-key>
TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret>
SENTRY_DSN=https://xxx@sentry.io/projectid

# --- Feature Flags ---
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_MAINTENANCE_MODE=false
