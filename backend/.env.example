# Backend Environment Variables Example
# Copy this file to .env.development or .env.production and fill in the values

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String
# Example: mongodb://localhost:27017/crammerly
MONGO_URI=mongodb://localhost:27017/crammerly

# JWT Secret Key (Minimum 64 characters for high-entropy production security)
# You can generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_key_at_least_64_chars_long_and_extremely_hard_to_guess

# Frontend Client URL (for CORS)
CLIENT_URL=https://crammerly.io

# Cookie Domain (Match your frontend domain to prevent cross-site session leakage)
COOKIE_DOMAIN=crammerly.io

# SMTP Credentials (Required for registration & password recovery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@crammerly.io

# DeepSeek AI API Key (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Feature Flags
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_MAINTENANCE_MODE=false

# Security & CAPTCHA (Cloudflare Turnstile)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Redis (For distributed rate limiting & background jobs)
REDIS_URL=redis://localhost:6379
